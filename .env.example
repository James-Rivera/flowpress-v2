# Deployment role:
# - backend on the 1 TB shop PC (UI + upload API + filesystem)
# - frontend on Vercel (public UI; uploads are sent to NEXT_PUBLIC_BACKEND_BASE_URL)
APP_ROLE=backend

# Required absolute filesystem root on the production backend.
# Keep customer data outside the application/repository directory.
UPLOADS_DIR=C:\FlowPressData\uploads

# Public backend origin used by the Vercel frontend. Leave empty on the shop PC
# so local send.cjnet uploads use the same host.
NEXT_PUBLIC_BACKEND_BASE_URL=

# Comma-separated browser origins permitted to call the shop PC upload API.
# Example: https://upload.example.com,https://www.example.com
ALLOWED_ORIGINS=

# Optional upload limits
UPLOAD_MAX_FILE_COUNT=20
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_BATCH_SIZE_MB=500
NEXT_PUBLIC_UPLOAD_MAX_FILE_COUNT=20
NEXT_PUBLIC_UPLOAD_MAX_FILE_SIZE_MB=100
NEXT_PUBLIC_UPLOAD_MAX_BATCH_SIZE_MB=500

# Backend safeguards
UPLOAD_RATE_LIMIT_PER_HOUR=60
UPLOAD_MAX_CONCURRENT=2
UPLOAD_MIN_FREE_SPACE_MB=5120
UPLOAD_RETENTION_HOURS=720
UPLOAD_MAX_DISK_USAGE_PERCENT=85

# Optional external contact links shown on the send hub.
NEXT_PUBLIC_MESSENGER_WEB_URL=https://m.me/cjnetvalley
NEXT_PUBLIC_MESSENGER_APP_URL=fb-messenger://user-thread/cjnetvalley
NEXT_PUBLIC_GMAIL_TO=cjnetvalley@gmail.com
NEXT_PUBLIC_GMAIL_SUBJECT=CJ NET Print Request
